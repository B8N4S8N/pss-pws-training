// Cascade Peer Academy — OHA-aligned PSS/PWS training platform
// Curriculum maps to OAR 950-060-0140 / 410-180-0370 THW standards

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseType {
  PSS
  PWS
}

enum DeliveryMode {
  AYOP
  HYBRID
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
  SUSPENDED
}

enum LessonType {
  READING
  VIDEO
  QUIZ
  REFLECTION
  DOCUMENTATION
  SCENARIO
  ROLEPLAY
  MODULE_AI_REVIEW
  LIVE_SESSION
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

enum AiSessionType {
  TUTOR
  ROLEPLAY
  INTERVIEW
  CRISIS_SIM
  DOCUMENTATION_COACH
  MODULE_REVIEW
  GENERATED_CURRICULUM
}

enum GeneratedContentKind {
  SECTION_READING
  SECTION_QUIZ
  MODULE_TEACHER
  MODULE_REVIEW_PACKET
  CUSTOM_SCENARIO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

model User {
  id               String   @id @default(cuid())
  clerkId          String?  @unique
  email            String   @unique
  /// Optional legacy/local hash — Clerk is the primary auth provider
  passwordHash     String?
  name             String
  role             Role     @default(STUDENT)
  phone            String?
  /// Lived experience declaration for THW eligibility (self-attested)
  peerIdentity     String?
  bio              String?
  avatarUrl        String?
  stripeCustomerId String?  @unique
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  reflections       Reflection[]
  aiSessions        AiSession[]
  attendanceRecords AttendanceRecord[]
  certificates      Certificate[]
  evaluations       CompetencyEvaluation[] @relation("StudentEvaluations")
  givenEvaluations  CompetencyEvaluation[] @relation("InstructorEvaluations")
  instructedCohorts Cohort[]               @relation("CohortInstructor")
  payments          Payment[]
  createdMaterials  CourseMaterial[]
  learnerProfile    LearnerProfile?
  generatedContent  GeneratedContent[]

  @@index([role])
  @@index([email])
}

model LearnerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  /// story | checklist | short-chunks | peer-talk
  learningStyle        String   @default("peer-talk")
  /// plain | standard
  readingLevel         String   @default("plain")
  backgroundNotes      String?
  /// JSON string[] of preferred example themes
  prefersExamplesJson  String?
  /// Optional model preference hint: free | balanced | quality
  modelPreference      String   @default("free")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GeneratedContent {
  id             String               @id @default(cuid())
  userId         String
  courseId       String?
  moduleId       String?
  chapterId      String?
  lessonId       String?
  kind           GeneratedContentKind
  title          String
  contentMd      String
  contentJson    String?
  modelUsed      String?
  provider       String?
  taskTier       String?
  promptMetaJson String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId])
  @@index([userId, kind])
  @@index([lessonId])
}

model Payment {
  id                      String        @id @default(cuid())
  userId                  String
  courseId                String
  deliveryMode            DeliveryMode  @default(AYOP)
  amountCents             Int
  currency                String        @default("usd")
  status                  PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?
  stripeCustomerId        String?
  paymentMethodTypes      String?
  metadataJson            String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([courseId])
}

model Course {
  id               String     @id @default(cuid())
  slug             String     @unique
  type             CourseType
  title            String
  subtitle         String?
  description      String
  contactHours     Int
  priceCents       Int        @default(120000)
  ohaAligned       Boolean    @default(true)
  /// JSON array of OAR competency codes covered
  competencies     String
  learningOutcomes String
  isPublished      Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  cohorts     Cohort[]
  payments    Payment[]
  materials   CourseMaterial[]

  @@index([type])
}

model Module {
  id             String   @id @default(cuid())
  courseId       String
  slug           String
  title          String
  description    String
  orderIndex     Int
  estimatedHours Float
  /// OAR topic references (e.g. "950-060-0140(2)(o)")
  oarReferences  String
  competencies   String
  unlockAfterId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters Chapter[]
  lessons  Lesson[]

  @@unique([courseId, slug])
  @@index([courseId, orderIndex])
}

model Chapter {
  id          String   @id @default(cuid())
  moduleId    String
  slug        String
  title       String
  description String?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module  Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
}

model Lesson {
  id                 String     @id @default(cuid())
  moduleId           String
  chapterId          String?
  slug               String
  title              String
  type               LessonType
  orderIndex         Int
  estimatedMinutes   Int
  contentMd          String
  videoUrl           String?
  referencesJson     String?
  learningModes      String?
  videoProvider      String?
  isModuleQuiz       Boolean    @default(false)
  isModuleAiReview   Boolean    @default(false)
  storytellingHook   String?
  /// JSON for quiz questions, scenario branches, documentation prompts, etc.
  interactivePayload String?
  passScore          Int        @default(80)
  isRequired         Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  chapter     Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  progress    LessonProgress[]
  quizzes     QuizAttempt[]
  reflections Reflection[]
  materials   CourseMaterial[]
  aiReviews   AiSession[]

  @@unique([moduleId, slug])
  @@index([moduleId, orderIndex])
  @@index([chapterId, orderIndex])
}

model CourseMaterial {
  id           String   @id @default(cuid())
  courseId     String
  lessonId     String?
  title        String
  description  String?
  materialType String
  url          String
  sortOrder    Int      @default(0)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([courseId, sortOrder])
  @@index([lessonId])
}

model Cohort {
  id               String       @id @default(cuid())
  courseId         String
  instructorId     String?
  name             String
  deliveryMode     DeliveryMode
  startDate        DateTime?
  endDate          DateTime?
  timezone         String       @default("America/Los_Angeles")
  liveSessionNotes String?
  maxSeats         Int          @default(25)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  course       Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   User?              @relation("CohortInstructor", fields: [instructorId], references: [id])
  enrollments  Enrollment[]
  liveSessions LiveSession[]
  attendance   AttendanceRecord[]

  @@index([courseId])
  @@index([deliveryMode])
}

model LiveSession {
  id          String   @id @default(cuid())
  cohortId    String
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  meetingUrl  String?
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cohort     Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  attendance AttendanceRecord[]

  @@index([cohortId, startsAt])
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  cohortId        String?
  deliveryMode    DeliveryMode
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  hoursLogged     Float            @default(0)
  overallProgress Float            @default(0)
  specialization  String?
  notes           String?
  updatedAt       DateTime         @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  cohort Cohort? @relation(fields: [cohortId], references: [id])

  @@unique([userId, courseId])
  @@index([status])
  @@index([deliveryMode])
}

model LessonProgress {
  id           String         @id @default(cuid())
  userId       String
  lessonId     String
  status       ProgressStatus @default(NOT_STARTED)
  score        Int?
  timeSpentMin Int            @default(0)
  completedAt  DateTime?
  feedback     String?
  updatedAt    DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  score       Int
  passed      Boolean
  answersJson String
  attemptNum  Int      @default(1)
  createdAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

model Reflection {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
}

model AiPersona {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  ageRange         String?
  presentation     String
  background       String
  challenges       String
  goals            String
  riskLevel        String   @default("moderate")
  tags             String
  systemPrompt     String
  evaluationRubric String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  sessions AiSession[]
}

model AiSession {
  id           String        @id @default(cuid())
  userId       String
  personaId    String?
  lessonId     String?
  moduleId     String?
  type         AiSessionType
  title        String
  messagesJson String        @default("[]")
  feedbackJson String?
  scoresJson   String?
  overallScore Int?
  durationSec  Int           @default(0)
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona AiPersona? @relation(fields: [personaId], references: [id])
  lesson  Lesson?    @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([personaId])
  @@index([lessonId])
  @@index([moduleId])
}

model AttendanceRecord {
  id            String   @id @default(cuid())
  userId        String
  cohortId      String
  liveSessionId String?
  present       Boolean  @default(false)
  minutes       Int      @default(0)
  notes         String?
  recordedAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohort      Cohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  liveSession LiveSession? @relation(fields: [liveSessionId], references: [id])

  @@index([userId, cohortId])
}

model CompetencyEvaluation {
  id             String     @id @default(cuid())
  studentId      String
  instructorId   String
  courseType     CourseType
  domainScores   String
  narrative      String
  recommendation String     @default("PENDING")
  liveObserved   Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  student    User @relation("StudentEvaluations", fields: [studentId], references: [id], onDelete: Cascade)
  instructor User @relation("InstructorEvaluations", fields: [instructorId], references: [id])

  @@index([studentId])
}

model Certificate {
  id              String       @id @default(cuid())
  userId          String
  courseType      CourseType
  certificateCode String       @unique
  hoursCompleted  Int
  issuedAt        DateTime     @default(now())
  instructorName  String
  deliveryMode    DeliveryMode
  specialization  String?
  pdfUrl          String?
  revoked         Boolean      @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, courseType])
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  iconKey     String
  criteria    String
  createdAt   DateTime @default(now())
}
