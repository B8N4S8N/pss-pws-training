DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="replace-with-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="Cascade Peer Academy"

# Clerk (written by `npx clerk@latest init` / Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/enroll

# Promote staff by email (comma-separated) until Clerk publicMetadata.role is set
ADMIN_EMAILS=admin@cascadepeer.academy
INSTRUCTOR_EMAILS=instructor@cascadepeer.academy

# Stripe — prefer restricted keys (rk_) in production
# Enable Klarna + Cash App Afterpay in Dashboard → Settings → Payment methods
# Do not hardcode payment_method_types (dynamic payment methods)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — live AI via Vercel AI Gateway (paid/free subset)
AI_GATEWAY_API_KEY=

# Free / metered BYOK providers (preferred for AI-generated modules)
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_API_KEY=  # alias also accepted

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Prefer providers that do not train on free-tier prompts (Groq before Google)
AI_PREFER_NO_TRAINING=1

# Optional per-task Gateway overrides (e.g. google/gemini-2.5-flash)
# AI_MODEL_TINY=
# AI_MODEL_TEACH=
# AI_MODEL_GENERATE=
# AI_MODEL_EVALUATE=
# AI_MODEL_ROLEPLAY=
# AI_MODEL_CRISIS=

NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
