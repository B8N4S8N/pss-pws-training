DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="replace-with-long-random-string"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="Cascade Peer Academy"

# Clerk (written by `npx clerk@latest init` / Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/enroll

# Promote staff by email (comma-separated) until Clerk publicMetadata.role is set
ADMIN_EMAILS=admin@cascadepeer.academy
INSTRUCTOR_EMAILS=instructor@cascadepeer.academy

# Stripe — prefer restricted keys (rk_) in production
# Enable Klarna + Cash App Afterpay in Dashboard → Settings → Payment methods
# Do not hardcode payment_method_types (dynamic payment methods)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — live AI streaming via Vercel AI Gateway
AI_GATEWAY_API_KEY=

NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/
